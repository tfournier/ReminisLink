{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ free" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ libres"
          }
        }
      }
    },
    "%@ freed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ libérés"
          }
        }
      }
    },
    "%@ goes to the trash of the console: it can be recovered until it is removed automatically after 30 days, or until the trash is emptied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va dans la corbeille de la console : récupérable jusqu’à son effacement automatique après 30 jours, ou jusqu’à ce que la corbeille soit vidée."
          }
        }
      }
    },
    "%@ is already installed on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est déjà installé sur la console."
          }
        }
      }
    },
    "%@ left" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ restantes"
          }
        }
      }
    },
    "%@ of %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@ stay on the SD card until they are removed automatically after 30 days, or until the trash is emptied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ restent sur la carte SD jusqu’à leur effacement automatique après 30 jours, ou jusqu’à ce que la corbeille soit vidée."
          }
        }
      }
    },
    "%@ used of %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utilisés sur %2$@"
          }
        }
      }
    },
    "%@ was installed instead of %@, which was not replaced." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a été installé au lieu de %2$@, qui n’a pas été remplacé."
          }
        }
      }
    },
    "%@ was moved to the trash of the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été mis dans la corbeille de la console."
          }
        }
      }
    },
    "%@ was replaced instead of %@. The previous %@ is in the trash of the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a été remplacé au lieu de %2$@. L’ancien %3$@ est dans la corbeille de la console."
          }
        }
      }
    },
    "%@ will be permanently deleted from the SD card. This cannot be undone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera supprimé définitivement de la carte SD. C’est irréversible."
          }
        }
      }
    },
    "%@ will be removed from this list. To use it again, scan its QR code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera retirée de cette liste. Pour l’utiliser de nouveau, scanne son QR code."
          }
        }
      }
    },
    "%@ · %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · state %lld" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · état %2$lld"
