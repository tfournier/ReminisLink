    "The screenshot was added to Photos." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture a été ajoutée à Photos."
          }
        }
      }
    },
    "The state goes to the trash of the console, removed automatically after 30 days or when it is emptied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état va dans la corbeille de la console, effacé automatiquement après 30 jours ou quand elle est vidée."
          }
        }
      }
    },
    "The state is being sent to the console. Follow it in Transfers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état est en cours d’envoi vers la console. Suis-le dans Transferts."
