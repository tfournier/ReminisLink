      }
    },
    "This console was forgotten on another of your Apple devices" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette console a été oubliée sur un autre de tes appareils Apple"
          }
        }
      }
    },
    "This console's identity changed: it is not the console paired with this app, or it was reset. Nothing was sent. Pair it again by scanning its QR code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identité de cette console a changé : ce n’est pas la console appairée avec cette app, ou elle a été réinitialisée. Rien n’a été envoyé. Appaire-la de nouveau en scannant son QR code."
          }
        }
      }
    },
    "This copy cannot be restored: it is damaged or was made by another emulator. Nothing was changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie ne peut pas être restaurée : elle est abîmée ou a été faite par un autre émulateur. Rien n’a été modifié."
          }
        }
      }
    },
    "This entry is no longer in the trash of the console, or ReminisLink on the console is too old to restore it (update it)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette entrée n’est plus dans la corbeille de la console, ou ReminisLink sur la console est trop ancien pour la restaurer (mets-le à jour)."
          }
        }
      }
    },
    "This file changed on the console. The list of files was refreshed: try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier a changé sur la console. La liste des fichiers a été rechargée : réessaie."
          }
        }
      }
    },
    "This file is not a ReminisLink game archive, or it is damaged, or it was made by a newer version of ReminisLink." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’est pas une archive de jeu ReminisLink, ou elle est abîmée, ou elle a été faite par une version plus récente de ReminisLink."
          }
        }
      }
    },
    "This file is not a patch the console can apply. Choose an IPS, BPS or UPS patch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’est pas un patch que la console sait appliquer. Choisis un patch IPS, BPS ou UPS."
          }
        }
      }
    },
    "This file is not a zip archive the console can read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’est pas une archive zip lisible par la console."
          }
        }
      }
    },
    "This folder holds more than 5,000 items: only the first 5,000 are shown." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier contient plus de 5 000 éléments : seuls les 5 000 premiers sont affichés."
          }
        }
      }
    },
    "This folder is empty" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier est vide"
          }
        }
      }
    },
    "This game has no data to export." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu n’a aucune donnée à exporter."
          }
        }
      }
    },
    "This game has no save on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu n’a pas de sauvegarde sur la console."
          }
        }
      }
    },
    "This game has no save yet: the file becomes its save." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu n’a pas encore de sauvegarde : le fichier devient sa sauvegarde."
          }
        }
      }
    },
    "This game has several discs: a patch applies to a single ROM file, so multi-disc games cannot be patched here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu a plusieurs disques : un patch s’applique à un seul fichier ROM, donc les jeux multi-disques ne peuvent pas être patchés ici."
          }
        }
      }
    },
    "This game is already on the console. Import the archive into that game instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu est déjà sur la console. Importe plutôt l’archive dans ce jeu."
          }
        }
      }
    },
    "This game is no longer on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu n’est plus sur la console."
          }
        }
      }
    },
    "This game seems to be already patched with this patch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu semble déjà patché avec ce patch."
          }
        }
      }
    },
    "This game uses a NextUI setting that ReminisLink does not handle yet (save or state format). Nothing was changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu utilise un réglage de NextUI que ReminisLink ne gère pas encore (format de sauvegarde ou d’état). Rien n’a été modifié."
          }
        }
      }
    },
    "This item no longer exists on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément n’existe plus sur la console."
          }
        }
      }
    },
    "This link is not a valid ReminisLink pairing link." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien n’est pas un lien d’appairage ReminisLink valide."
          }
        }
      }
    },
    "This list changed on the console. Your changes can no longer be saved over it: discard them to see the new list." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste a changé sur la console. Tes modifications ne peuvent plus l’écraser : abandonne-les pour voir la nouvelle liste."
          }
        }
      }
    },
    "This name identifies all your Apple devices signed in with the same Apple Account: they share one pairing through iCloud Keychain." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
