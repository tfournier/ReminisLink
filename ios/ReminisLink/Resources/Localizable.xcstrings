      }
    },
    "The console refused the request." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a refusé la demande."
          }
        }
      }
    },
    "The console refused this archive to protect the SD card (a link, or a file outside the pak folder)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a refusé cette archive pour protéger la carte SD (un lien, ou un fichier hors du dossier du pak)."
          }
        }
      }
    },
    "The console refused this file name." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a refusé ce nom de fichier."
          }
        }
