    "The console writes the automatic resume state when it goes to sleep or turns off during a game." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console écrit l’état de reprise automatique quand elle se met en veille ou s’éteint pendant une partie."
          }
        }
      }
    },
    "The copy goes back to the backup copies of the game; the current save does not change." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie retourne parmi les copies de secours du jeu ; la sauvegarde actuelle ne change pas."
          }
        }
      }
    },
    "The copy goes to the trash of the console. The current save does not change." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie part dans la corbeille de la console. La sauvegarde actuelle ne change pas."
          }
        }
      }
    },
    "The current cheats are replaced by the imported ones. The previous file is kept on the console (.cht.bak)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes de triche actuels sont remplacés par ceux importés. Le fichier précédent est gardé sur la console (.cht.bak)."
          }
        }
      }
    },
    "The current cheats are replaced. The previous file is kept on the console (.cht.bak)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes de triche actuels sont remplacés. Le fichier précédent est gardé sur la console (.cht.bak)."
          }
        }
      }
    },
    "The current image goes to the trash of the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image actuelle part dans la corbeille de la console."
          }
        }
      }
    },
    "The current resume state is archived first, then replaced by the version of %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état de reprise actuel est d’abord archivé, puis remplacé par la version du %@."
          }
        }
      }
    },
    "The current save cannot be replaced now: something else holds the place of the save or of its copy on the SD card." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde actuelle ne peut pas être remplacée pour l’instant : autre chose occupe la place de la sauvegarde ou de sa copie sur la carte SD."
          }
        }
      }
    },
    "The current save is first copied (backup copy), then replaced by the copy of %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde actuelle est d’abord copiée (copie de secours), puis remplacée par la copie du %@."
          }
        }
      }
    },
    "The current save is first copied (backup copy)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
