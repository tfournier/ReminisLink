    },
    "The trash is empty" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La corbeille est vide"
          }
        }
      }
    },
    "The version is being sent to the console. Follow it in Transfers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version est en cours d’envoi vers la console. Suis-la dans Transferts."
          }
        }
      }
    },
    "They stay 30 days in the trash of the console, where you can restore them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles restent 30 jours dans la corbeille de la console, où tu peux les restaurer."
          }
        }
      }
    },
    "This QR code comes from a newer version of ReminisLink. Update the app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce QR code vient d’une version plus récente de ReminisLink. Mets à jour l’app."
          }
        }
      }
    },
    "This QR code comes from an older version of ReminisLink. Update ReminisLink on the console, then scan the new QR code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce QR code vient d’une ancienne version de ReminisLink. Mets à jour ReminisLink sur la console, puis scanne le nouveau QR code."
          }
        }
      }
    },
    "This app" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app"
          }
        }
      }
    },
    "This archive holds more than one pak. Install them one at a time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette archive contient plusieurs paks. Installe-les un par un."
          }
        }
      }
    },
    "This archive is encrypted or compressed in a way the console cannot read." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette archive est chiffrée ou compressée d’une façon que la console ne sait pas lire."
          }
