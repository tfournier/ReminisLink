    "Automatic copies are limited to 10 per game: the oldest ones are deleted. Copies you make yourself are kept." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies automatiques sont limitées à 10 par jeu : les plus anciennes sont supprimées. Les copies que tu fais toi-même sont conservées."
          }
        }
      }
    },
    "Automatic copy" : {
      "localizations" : {
        "fr" : {
