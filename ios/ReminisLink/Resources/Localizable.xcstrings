        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version"
          }
        }
      }
    },
    "Version restored. The previous save is in the backup copies of the game on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version restaurée. La save précédente est dans les copies de sauvegarde du jeu sur la console."
          }
        }
      }
    },
    "Versions: %lld · latest %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versions : %1$lld · dernière le %2$@"
          }
        }
      }
    },
    "Viewing and downloading still work. Changes are disabled on this iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulter et télécharger restent possibles. Les modifications sont désactivées sur cet iPhone."
          }
        }
      }
    },
