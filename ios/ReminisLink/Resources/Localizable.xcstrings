{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ becomes read-only. Its transfers in progress pause." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passe en lecture seule. Ses transferts en cours se mettent en pause."
          }
        }
      }
    },
    "%@ free" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ libres"
          }
        }
      }
    },
    "%@ freed" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ libérés"
          }
        }
      }
    },
    "%@ left" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ restantes"
          }
        }
      }
    },
    "%@ of %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@ stay on the SD card for at least 30 days, until the trash is emptied." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ restent sur la carte SD pendant au moins 30 jours, jusqu’à ce que la corbeille soit vidée."
          }
        }
      }
    },
    "%@ used of %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ utilisés sur %2$@"
          }
        }
      }
    },
    "%@ will be permanently deleted from the SD card. This cannot be undone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera supprimé définitivement de la carte SD. C’est irréversible."
          }
        }
      }
    },
