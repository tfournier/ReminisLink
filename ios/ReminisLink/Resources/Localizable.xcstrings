    "Up to 10 versions are kept; the oldest is removed when a new one is synced." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à 10 versions sont gardées ; la plus ancienne est retirée quand une nouvelle est synchronisée."
          }
        }
      }
    },
    "Up to date · saves checked: %lld" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
