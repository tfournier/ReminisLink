      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envois"
          }
        }
      }
    },
    "Uploads in progress are paused. Open ReminisLink on the console, then the console here, to go on." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les envois en cours sont en pause. Ouvre ReminisLink sur la console, puis la console ici, pour continuer."
          }
        }
      }
    },
