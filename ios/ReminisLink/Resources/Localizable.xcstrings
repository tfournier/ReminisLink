      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de la console…"
          }
        }
      }
    },
    "Wi-Fi" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi"
          }
        }
      }
    },
    "Will be created: %@. If the name is taken, the console adds a number. The extension of the game is added when the name does not end with it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sera créé : %@. Si le nom est pris, la console ajoute un numéro. L’extension du jeu est ajoutée quand le nom ne se termine pas par elle."
          }
        }
      }
    },
    "With its clock file" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec son fichier d’horloge"
          }
        }
      }
    },
    "Yes" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oui"
          }
        }
      }
    },
    "You can close this screen: the console goes on. Follow it in Transfers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux fermer cet écran : la console continue. Suis-la dans Transferts."
          }
        }
      }
    },
    "Your changes were not saved. Reloading shows the list of the console and discards your changes on this iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes modifications n’ont pas été enregistrées. Recharger affiche la liste de la console et abandonne tes modifications sur cet iPhone."
          }
        }
      }
    },
    "action.save" : {
      "comment" : "Verb: saves the changes of the cheat list",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer"
          }
        }
      }
    },
    "iCloud Drive is not available: saves are kept on this iPhone only (Files > On My iPhone > ReminisLink). Turn on iCloud Drive for ReminisLink in Settings to keep them in iCloud." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive n’est pas disponible : les saves sont gardées sur cet iPhone seulement (Fichiers > Sur mon iPhone > ReminisLink). Active iCloud Drive pour ReminisLink dans Réglages pour les garder dans iCloud."
          }
        }
      }
    },
    "“%@” becomes the save of %@, which has none yet." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » devient la save de %2$@, qui n’en a pas encore."
          }
        }
      }
    },
    "“%@” replaces the save of %@. The current save is first copied (backup copy)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » remplace la save de %2$@. La save actuelle est d’abord copiée (copie de sauvegarde)."
          }
        }
      }
    }
  },
  "version" : "1.0"
