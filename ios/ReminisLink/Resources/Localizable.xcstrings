    },
    "The cancellation could not be sent: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’annulation n’a pas pu être envoyée : %@"
          }
        }
      }
    },
    "The cancellation did not reach the console. The transfer is kept: cancel it again, or resume it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’annulation n’a pas atteint la console. Le transfert est gardé : annule-le à nouveau, ou reprends-le."
          }
        }
      }
    },
    "The cheat file of the game is deleted on the console; its previous content is kept there (.cht.bak)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de codes de triche du jeu est supprimé sur la console ; son contenu précédent y est gardé (.cht.bak)."
          }
        }
      }
    },
    "The clocks of the console and of this iPhone are too far apart." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The clocks of the console and of this device are too far apart."
                }
              },
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The clocks of the console and of this iPhone are too far apart."
                }
              },
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The clocks of the console and of this device are too far apart."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The clocks of the console and of this device are too far apart."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les horloges de la console et de cet appareil sont trop décalées."
                }
              },
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les horloges de la console et de cet iPhone sont trop décalées."
                }
              },
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les horloges de la console et de cet appareil sont trop décalées."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les horloges de la console et de cet appareil sont trop décalées."
                }
              }
            }
          }
        }
      }
    },
    "The code is written as in a RetroArch cheat file (for example several codes joined with +)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code s’écrit comme dans un fichier de codes de triche RetroArch (par exemple plusieurs codes reliés par +)."
          }
        }
      }
    },
    "The connection was lost while the console was finishing the file. Check the library before sending it again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été perdue pendant que la console finalisait le fichier. Vérifie la bibliothèque avant de le renvoyer."
          }
        }
      }
    },
    "The console closed ReminisLink" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a quitté ReminisLink"
          }
        }
      }
    },
    "The console closed ReminisLink." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a quitté ReminisLink."
          }
        }
      }
    },
    "The console could not name this pak. Rename the archive Name.pak.zip and try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console n’a pas pu nommer ce pak. Renomme l’archive Nom.pak.zip et réessaie."
          }
        }
      }
    },
    "The console could not prove its identity. Pairing was cancelled." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console n’a pas pu prouver son identité. L’appairage a été annulé."
          }
        }
      }
    },
    "The console found nothing it can use in this file." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console n’a rien trouvé d’utilisable dans ce fichier."
          }
        }
      }
    },
    "The console goes on with the task; its state shows again once it answers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console poursuit la tâche ; son état s’affichera de nouveau dès qu’elle répondra."
          }
        }
      }
    },
    "The console has too many games to list them at once: browse them by console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a trop de jeux pour les lister d’un coup : parcours-les par console."
          }
        }
      }
    },
    "The console is busy with another change. Nothing was changed. Try again in %lld seconds." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The console is busy with another change. Nothing was changed. Try again in %lld second."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The console is busy with another change. Nothing was changed. Try again in %lld seconds."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "La console est occupée par une autre modification. Rien n’a été modifié. Réessaie dans %lld seconde."
