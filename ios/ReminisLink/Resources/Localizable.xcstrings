    "%lld/%lld · A copy of the current save is made on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld/%2$lld · Une copie de la save actuelle est faite sur la console."
          }
        }
      }
    },
    "6-digit PIN" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN à 6 chiffres"
          }
        }
      }
    },
    "A RetroArch cheat file (.cht). It is sent to the console, then imported." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier de cheats RetroArch (.cht). Il est envoyé à la console, puis importé."
          }
        }
      }
    },
    "A file with this name already exists on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier de ce nom existe déjà sur la console."
          }
        }
      }
    },
    "A file with this name already exists on the console: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier de ce nom existe déjà sur la console : %@"
          }
        }
      }
    },
    "A lock keeps a copy of the state on the console. It cannot stop a game from overwriting the state: the state is restored the next time ReminisLink is opened on the console if it was overwritten in game." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un verrou garde une copie du state sur la console. Il ne peut pas empêcher un jeu d’écraser le state : le state est restauré à la prochaine ouverture de ReminisLink sur la console s’il a été écrasé en jeu."
          }
        }
      }
    },
