    "Test Picture" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image de test"
          }
        }
      }
    },
    "The .cht files of the Cheats folder of the SD card. Those named after this game come first." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers .cht du dossier Cheats de la carte SD. Ceux qui portent le nom de ce jeu sont en premier."
          }
        }
      }
    },
    "The .ips, .bps and .ups files of the Roms folder and of the ReminisLink/patches folder of the SD card." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers .ips, .bps et .ups du dossier Roms et du dossier ReminisLink/patches de la carte SD."
          }
        }
      }
    },
    "The PIN is shown below the QR code, on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PIN est affiché sous le QR code, sur la console."
          }
        }
      }
    },
    "The ROM changed while the patch was applied. Nothing was changed, try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ROM a changé pendant l’application. Rien n’a été modifié, réessaie."
          }
        }
      }
    },
    "The cancellation could not be sent: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’annulation n’a pas pu être envoyée : %@"
          }
        }
      }
    },
    "The cancellation did not reach the console. The transfer is kept: cancel it again, or resume it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’annulation n’a pas atteint la console. Le transfert est gardé : annule-le à nouveau, ou reprends-le."
          }
        }
      }
    },
    "The cheat file of the game is deleted on the console; its previous content is kept there (.cht.bak)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de cheats du jeu est supprimé sur la console ; son contenu précédent y est gardé (.cht.bak)."
          }
        }
      }
    },
    "The clocks of the console and of this iPhone are too far apart." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les horloges de la console et de cet iPhone sont trop décalées."
          }
        }
      }
    },
    "The code is written as in a RetroArch cheat file (for example several codes joined with +)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code s’écrit comme dans un fichier de cheats RetroArch (par exemple plusieurs codes reliés par +)."
          }
        }
      }
    },
    "The connection was lost while the console was finishing the file. Check the library before sending it again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été perdue pendant que la console finalisait le fichier. Vérifie la bibliothèque avant de le renvoyer."
          }
        }
      }
    },
    "The console closed ReminisLink" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a quitté ReminisLink"
          }
        }
      }
    },
    "The console could not download the patch. Check the link and the Wi-Fi connection of the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console n’a pas pu télécharger le patch. Vérifie le lien et la connexion Wi-Fi de la console."
          }
        }
      }
    },
    "The console could not prove its identity. Pairing was cancelled." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console n’a pas pu prouver son identité. L’appairage a été annulé."
          }
        }
      }
    },
    "The console downloaded the patch before the cancellation arrived. Nothing was applied: tap Apply to use it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a téléchargé le patch avant l’arrivée de l’annulation. Rien n’a été appliqué : touche Appliquer pour l’utiliser."
          }
        }
      }
    },
    "The console downloads the .cht file itself (5 MB at most)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console télécharge elle-même le fichier .cht (5 Mo au maximum)."
          }
        }
      }
    },
    "The console downloads the file itself, on its own Wi-Fi connection." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console télécharge le fichier elle-même, avec sa propre connexion Wi-Fi."
          }
        }
      }
    },
    "The console downloads the patch itself, on its own Wi-Fi connection." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console télécharge le patch elle-même, avec sa propre connexion Wi-Fi."
          }
        }
      }
    },
    "The console found nothing it can use in this file." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console n’a rien trouvé d’utilisable dans ce fichier."
          }
        }
      }
    },
    "The console goes on with the task; its state shows again once it answers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console poursuit la tâche ; son état s’affichera de nouveau dès qu’elle répondra."
          }
        }
      }
    },
    "The console has too many games to list them at once: browse them by console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a trop de jeux pour les lister d’un coup : parcours-les par console."
          }
        }
      }
    },
    "The console is downloading the patch…" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console télécharge le patch…"
          }
        }
      }
    },
    "The console is not responding." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console ne répond plus."
          }
        }
      }
    },
    "The console keeps interrupting the transfer. Try again later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console interrompt sans cesse le transfert. Réessaie plus tard."
          }
        }
      }
    },
    "The console listed only its first 10,000 saves." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console n’a listé que ses 10 000 premières saves."
          }
        }
      }
    },
    "The console ran into an error. Details are in its log." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a rencontré une erreur. Les détails sont dans son journal."
          }
        }
      }
    },
    "The console refused the request." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a refusé la demande."
          }
        }
      }
    },
    "The console refused this file name." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a refusé ce nom de fichier."
          }
        }
      }
    },
    "The console reported an error (%@)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a signalé une erreur (%@)."
          }
        }
      }
    },
    "The console sent an unexpected answer." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a envoyé une réponse inattendue."
          }
        }
      }
    },
    "The console was restarted and stopped this task. Check the library before trying again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a redémarré et a arrêté cette tâche. Vérifie la bibliothèque avant de réessayer."
          }
        }
      }
    },
    "The console was restarted: this download was stopped." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a redémarré : ce téléchargement a été arrêté."
          }
        }
      }
    },
    "The console was restarted: this patch was stopped." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console a redémarré : ce patch a été arrêté."
          }
        }
      }
    },
    "The console will forget this iPhone. To reconnect, pair it again: on the console, open Settings > Pair a New Device and scan the QR code." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console oubliera cet iPhone. Pour te reconnecter, appaire-le à nouveau : sur la console, ouvre Réglages > Appairer un nouvel appareil et scanne le QR code."
          }
        }
      }
    },
    "The copy goes to the trash of the console. The current save does not change." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie part dans la corbeille de la console. La save actuelle ne change pas."
          }
        }
      }
    },
    "The current cheats are replaced by the imported ones. The previous file is kept on the console (.cht.bak)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cheats actuels sont remplacés par ceux importés. Le fichier précédent est gardé sur la console (.cht.bak)."
          }
        }
      }
    },
    "The current cheats are replaced. The previous file is kept on the console (.cht.bak)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cheats actuels sont remplacés. Le fichier précédent est gardé sur la console (.cht.bak)."
          }
        }
      }
    },
    "The current image goes to the trash of the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image actuelle part dans la corbeille de la console."
          }
        }
      }
    },
    "The current resume state is archived first, then replaced by the version of %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le state de reprise actuel est d’abord archivé, puis remplacé par la version du %@."
          }
        }
      }
    },
    "The current save is first copied (backup copy), then replaced by the copy of %@." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La save actuelle est d’abord copiée (copie de sauvegarde), puis remplacée par la copie du %@."
          }
        }
      }
    },
    "The current save is first copied (backup copy)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La save actuelle est d’abord copiée (copie de sauvegarde)."
          }
        }
      }
    },
    "The current state goes to the trash of the console, then the locked copy replaces it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le state actuel va dans la corbeille de la console, puis la copie verrouillée le remplace."
          }
        }
      }
    },
    "The file arrived damaged on the console and was discarded. Send it again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est arrivé abîmé sur la console et a été écarté. Renvoie-le."
          }
        }
      }
    },
    "The file changed on this iPhone during the transfer. Add it again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier a changé sur cet iPhone pendant le transfert. Ajoute-le à nouveau."
          }
        }
      }
    },
    "The file could not be read on this iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n’a pas pu être lu sur cet iPhone."
          }
        }
      }
    },
    "The imported cheats are added after the current ones." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cheats importés sont ajoutés après les cheats actuels."
          }
        }
      }
    },
    "The list changed on the console. Reload it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste a changé sur la console. Recharge-la."
          }
        }
      }
    },
    "The list changed on the console. Reload?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste a changé sur la console. Recharger ?"
          }
        }
      }
    },
    "The list of the console stays as it is." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste de la console reste telle quelle."
          }
        }
      }
    },
    "The locked copy is deleted. The state itself does not change, but it is no longer restored if a game overwrites it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie verrouillée est supprimée. Le state lui-même ne change pas, mais il ne sera plus restauré si un jeu l’écrase."
          }
        }
      }
    },
    "The locked copy is the only version left, or differs from the state: it goes to the trash of the console. The state itself does not change." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie verrouillée est la seule version restante, ou diffère du state : elle part dans la corbeille de la console. Le state lui-même ne change pas."
          }
        }
      }
    },
    "The original ROM goes to the trash of the console. The save, the states and the cheats are kept." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ROM d’origine part dans la corbeille de la console. La save, les states et les cheats sont conservés."
          }
        }
      }
    },
    "The other device becomes read-only. Its transfers in progress pause." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autre appareil passe en lecture seule. Ses transferts en cours se mettent en pause."
          }
        }
      }
    },
    "The pairing information could not be read or saved on this iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations d’appairage n’ont pas pu être lues ou enregistrées sur cet iPhone."
          }
        }
      }
    },
    "The request is too large for the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête est trop grosse pour la console."
          }
        }
      }
    },
    "The save changed on the console during the sync, or arrived damaged. It was not kept; the next sync will try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La save a changé sur la console pendant la synchronisation, ou est arrivée abîmée. Elle n’a pas été gardée ; la prochaine synchronisation réessaiera."
          }
        }
      }
    },
    "The save is larger than 64 MB: it is being sent in Transfers. The current save is copied first." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La save dépasse 64 Mo : elle est envoyée dans Transferts. La save actuelle est d’abord copiée."
          }
        }
      }
    },
    "The save of %@ on the console will be replaced by the version of %@. The console first keeps a copy of its current save (Before replace). The clock file on the console is kept as it is." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La save de %1$@ sur la console sera remplacée par la version du %2$@. La console garde d’abord une copie de sa save actuelle (Avant remplacement). Le fichier d’horloge de la console est conservé tel quel."
          }
        }
      }
    },
    "The save, its clock file, the states, their locks and the resume history stay in place on the SD card." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La save, son fichier d’horloge, les states, leurs verrous et l’historique de reprise restent en place sur la carte SD."
          }
        }
      }
    },
    "The saves of a console (with their clock files) are copied to this iPhone only, never to the publisher of the app. Up to 10 versions are kept per save." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les saves d’une console (avec leurs fichiers d’horloge) sont copiées sur cet iPhone seulement, jamais chez l’éditeur de l’app. Jusqu’à 10 versions sont gardées par save."
          }
        }
      }
    },
    "The saves of a console (with their clock files) are copied to your own iCloud Drive, never to the publisher of the app. Up to 10 versions are kept per save." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les saves d’une console (avec leurs fichiers d’horloge) sont copiées dans ton propre iCloud Drive, jamais chez l’éditeur de l’app. Jusqu’à 10 versions sont gardées par save."
          }
        }
      }
    },
    "The saves of a console (with their clock files) are copied to your own iCloud Drive, or to this iPhone when iCloud Drive is off; never to the publisher of the app. Up to 10 versions are kept per save." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les saves d’une console (avec leurs fichiers d’horloge) sont copiées dans ton propre iCloud Drive, ou sur cet iPhone quand iCloud Drive est désactivé ; jamais chez l’éditeur de l’app. Jusqu’à 10 versions sont gardées par save."
          }
        }
      }
    },
    "The scanner is not available on this device. Scan the QR code with the Camera app, or use the PIN." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scanner n’est pas disponible sur cet appareil. Scanne le QR code avec l’app Appareil photo, ou utilise le PIN."
          }
        }
      }
    },
    "The shared links are offered in the Link tab once the files are sent." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens partagés sont proposés dans l’onglet Lien une fois les fichiers envoyés."
          }
        }
      }
    },
    "The state goes to the trash of the console, where it stays for at least 30 days." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le state va dans la corbeille de la console, où il reste au moins 30 jours."
          }
        }
      }
    },
    "The synced saves could not be read or written on this iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les saves synchronisées n’ont pas pu être lues ou écrites sur cet iPhone."
          }
        }
      }
    },
    "The trash is empty" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La corbeille est vide"
          }
        }
      }
    },
    "The version is being sent to the console. Follow it in Transfers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version est en cours d’envoi vers la console. Suis-la dans Transferts."
          }
        }
      }
    },
    "This cheat has other settings from its file. They are kept as they are." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce cheat a d’autres réglages venant de son fichier. Ils sont conservés tels quels."
          }
        }
      }
    },
    "This console is already paired. Pair it again?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette console est déjà appairée. Refaire l’appairage ?"
          }
        }
      }
    },
    "This console no longer recognizes your iPhone." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette console ne reconnaît plus ton iPhone."
          }
        }
      }
    },
    "This copy cannot be restored: it is damaged or was made by another emulator. Nothing was changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie ne peut pas être restaurée : elle est abîmée ou a été faite par un autre émulateur. Rien n’a été modifié."
          }
        }
      }
    },
    "This file changed on the console. The list of files was refreshed: try again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier a changé sur la console. La liste des fichiers a été rechargée : réessaie."
          }
        }
      }
    },
    "This file is not a patch the console can apply. Choose an IPS, BPS or UPS patch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’est pas un patch que la console sait appliquer. Choisis un patch IPS, BPS ou UPS."
          }
        }
      }
    },
    "This game has no save on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu n’a pas de save sur la console."
          }
        }
      }
    },
    "This game has no save yet: the file becomes its save." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu n’a pas encore de save : le fichier devient sa save."
          }
        }
      }
    },
    "This game has several discs: a patch applies to a single ROM file, so multi-disc games cannot be patched here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu a plusieurs disques : un patch s’applique à un seul fichier ROM, donc les jeux multi-disques ne peuvent pas être patchés ici."
          }
        }
      }
    },
    "This game seems to be already patched with this patch." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu semble déjà patché avec ce patch."
          }
        }
      }
    },
    "This game uses a NextUI setting that ReminisLink does not handle yet (save or state format). Nothing was changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeu utilise un réglage de NextUI que ReminisLink ne gère pas encore (format de save ou de state). Rien n’a été modifié."
          }
        }
      }
    },
    "This item no longer exists on the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément n’existe plus sur la console."
          }
        }
      }
    },
    "This link is not a valid ReminisLink pairing link." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien n’est pas un lien d’appairage ReminisLink valide."
          }
        }
      }
    },
    "This patch does not match this ROM. Check the ROM version the patch asks for." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce patch ne correspond pas à cette ROM. Vérifie la version de la ROM demandée par le patch."
          }
        }
      }
    },
    "This patch or the patched ROM is too large for the console." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce patch ou la ROM patchée est trop gros pour la console."
          }
        }
      }
    },
    "This picture cannot be used as the image of the game. Choose another one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette image ne peut pas servir d’image du jeu. Choisis-en une autre."
          }
        }
      }
    },
    "This state is locked on the console. Unlock it first." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce state est verrouillé sur la console. Déverrouille-le d’abord."
          }
        }
      }
    },
    "This version changed on this iPhone since it was shown. Nothing was sent to the console; open the list again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version a changé sur cet iPhone depuis son affichage. Rien n’a été envoyé à la console ; rouvre la liste."
          }
        }
      }
    },
    "This version of the app is not compatible with the ReminisLink version on the console. Update both." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de l’app n’est pas compatible avec la version de ReminisLink sur la console. Mets les deux à jour."
          }
        }
      }
    },
    "Too many attempts. Try again in %lld seconds." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Too many attempts. Try again in %lld second."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Too many attempts. Try again in %lld seconds."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Trop de tentatives. Réessaie dans %lld seconde."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Trop de tentatives. Réessaie dans %lld secondes."
                }
              }
            }
          }
        }
      }
    },
    "Too many attempts. Try again in a moment." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives. Réessaie dans un instant."
          }
        }
      }
    },
    "Total size: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille totale : %@"
          }
        }
      }
    },
    "Total: %@" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total : %@"
          }
        }
      }
    },
    "Transfers" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transferts"
          }
        }
      }
    },
    "Trash" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corbeille"
          }
        }
      }
    },
    "Try Again" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayer"
          }
        }
      }
    },
    "Turn a cheat on or off, tap it to edit it, and use Edit to reorder or delete. The previous file is kept on the console (.cht.bak)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active ou désactive un cheat, touche-le pour le modifier, et utilise Modifier pour réordonner ou supprimer. Le fichier précédent est gardé sur la console (.cht.bak)."
          }
        }
      }
    },
    "Type" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type"
          }
        }
      }
    },
    "Unlock" : {
      "localizations" : {
