      }
    },
    "The console is not responding." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console ne répond plus."
          }
        }
      }
    },
    "The console keeps interrupting the transfer. Try again later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La console interrompt sans cesse le transfert. Réessaie plus tard."
