        "fr" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les modifications restent sur cet appareil tant que tu ne les as pas enregistrées."
                }
              },
              "iphone" : {
                "stringUnit" : {
