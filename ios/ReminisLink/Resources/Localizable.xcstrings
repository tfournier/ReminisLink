    "Changes are kept on this iPhone until you save them." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Changes are kept on this device until you save them."
                }
              },
              "iphone" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Changes are kept on this iPhone until you save them."
                }
              },
              "mac" : {
