// Shared build settings of the ReminisLink Xcode project.
//
// RL_BUNDLE_PREFIX is the only value to change once the Apple Developer
// account is known (docs/specs/06-app-ios.md §1): every identifier, the app
// group and the shared Keychain group derive from it. com.example is a
// neutral placeholder that builds for the simulator without any account.

RL_BUNDLE_PREFIX = com.example

RL_APP_BUNDLE_ID = $(RL_BUNDLE_PREFIX).reminislink
RL_SHARE_BUNDLE_ID = $(RL_BUNDLE_PREFIX).reminislink.share
RL_APP_GROUP = group.$(RL_BUNDLE_PREFIX).reminislink
// AppIdentifierPrefix is empty without a team (simulator builds).
RL_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(RL_BUNDLE_PREFIX).reminislink.shared

// Version shown on the App Store, and build number: increase the build
// number for every upload to App Store Connect.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// No signing team: set DEVELOPMENT_TEAM (the Team ID of the Apple Developer
// account) to run on a device or archive for TestFlight, here or in
// Config/Local.xcconfig (untracked, see ios/README.md).
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Optional personal overrides (RL_BUNDLE_PREFIX, DEVELOPMENT_TEAM), never
// committed. Must stay last.
#include? "Local.xcconfig"
