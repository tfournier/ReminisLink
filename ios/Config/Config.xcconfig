// Shared build settings of the ReminisLink Xcode project.
//
// Identifiers (docs/specs/06-app-ios.md §1): the app is link.reminis.app,
// from the product domain reminis.link. The extension, the app group and
// the shared Keychain group derive from RL_APP_BUNDLE_ID. Never change it
// once the app is published: a new identifier is a new app, and the pairing
// keys kept in the Keychain would be lost.

RL_BUNDLE_PREFIX = link.reminis

RL_APP_BUNDLE_ID = $(RL_BUNDLE_PREFIX).app
RL_SHARE_BUNDLE_ID = $(RL_APP_BUNDLE_ID).share
RL_APP_GROUP = group.$(RL_APP_BUNDLE_ID)
// AppIdentifierPrefix is empty without a team (simulator builds).
RL_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(RL_APP_BUNDLE_ID).shared

// Version shown on the App Store, and build number: increase the build
// number for every upload to App Store Connect.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// No signing team: set DEVELOPMENT_TEAM (the Team ID of the Apple Developer
// account) to run on a device or archive for TestFlight, here or in
// Config/Local.xcconfig (untracked, see ios/README.md).
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// Optional personal overrides (DEVELOPMENT_TEAM), never committed. Must stay last.
#include? "Local.xcconfig"
