#!/bin/bash
# A stand-in for git in scripts/test-release-scripts.sh: logs every call to
# $FAKE_LOG and answers as a clean main branch without the tag. Never runs git.
echo "git $*" >>"$FAKE_LOG"
case "$*" in
"rev-parse --abbrev-ref HEAD") echo main ;;
"status --porcelain") ;;
"rev-parse -q --verify "*) exit 1 ;;
"diff --quiet "*) exit 1 ;;
esac
exit 0
